<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hackathon_item_form_inherit_c" model="ir.ui.view">
        <field name="name">hackathon.item.form.inherit.c</field>
        <field name="model">hackathon.item</field>
        <field name="inherit_id" ref="hackathon_core.view_hackathon_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Notes">
                    <field name="feature_c_notes"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
